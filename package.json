{
  "name": "gitchangelog",
  "type": "module",
  "version": "0.0.0",
  "description": "Generate and maintain CHANGELOG.md from Conventional Commits.",
  "author": "edram",
  "license": "MIT",
  "homepage": "https://github.com/edram/gitchangelog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edram/gitchangelog.git"
  },
  "bugs": {
    "url": "https://github.com/edram/gitchangelog/issues"
  },
  "bin": {
    "changelog": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/cli.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "changelog",
    "cli",
    "conventional-commits",
    "git"
  ],
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "tsdown": "^0.22.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "cac": "^7.0.0",
    "tinyexec": "^1.2.4"
  }
}
